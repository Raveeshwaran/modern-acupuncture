# Apply these in your host environment; .env is not auto-loaded.
DEMO_MODE=1
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# Set COOKIE_SECURE=1 only behind HTTPS.
COOKIE_SECURE=0
# Optional: supply SECRET_KEY and DATA_KEY through a secret manager.
# DATA_KEY must be a Fernet key. Never change it without migrating encrypted records.
